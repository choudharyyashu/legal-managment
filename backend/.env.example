# ==============================================================================
# HEUGLY & BLUDWORTH LEGAL PRACTICE MANAGEMENT — LOCAL ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables for your local development environment.
# Never commit actual credentials, secrets, or production connection strings.

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MySQL 8.4 LTS / MariaDB via XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=legal-db

# Prisma Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/legal-db"

# Authentication & JWT Secrets (Minimum 32 characters for HMAC SHA-256)
JWT_ACCESS_SECRET="change_me_local_development_jwt_access_secret_min_32_chars"
JWT_REFRESH_SECRET="change_me_local_development_jwt_refresh_secret_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Logging & Diagnostics
LOG_LEVEL=info

