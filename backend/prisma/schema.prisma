model PISettlementDisbursementVersion {
  id                          String                 @id @default(uuid()) @db.VarChar(36)
  settlementDisbursementId    String                 @map("settlement_disbursement_id") @db.VarChar(36)
  versionNumber               Int                    @map("version_number")
  grossSettlementAmount       Decimal                @map("gross_settlement_amount") @db.Decimal(12, 2)
  contingencyFeePercentage    Decimal                @map("contingency_fee_percentage") @db.Decimal(5, 2)
  calculatedAttorneyFee       Decimal                @map("calculated_attorney_fee") @db.Decimal(12, 2)
  totalLitigationCosts        Decimal                @map("total_litigation_costs") @db.Decimal(12, 2)
  totalClientAdvances         Decimal                @default(0.00) @map("total_client_advances") @db.Decimal(12, 2)
  totalMedicalLiens           Decimal                @map("total_medical_liens") @db.Decimal(12, 2)
  otherDeductions             Decimal                @default(0.00) @map("other_deductions") @db.Decimal(12, 2)
  netClientRecovery           Decimal                @map("net_client_recovery") @db.Decimal(12, 2)
  versionStatus               String                 @default("DRAFT") @map("version_status") @db.VarChar(50)
  isImmutable                 Boolean                @default(false) @map("is_immutable")
  signedClosingStatementDocId String?                @map("signed_closing_statement_doc_id") @db.VarChar(36)
  clientApprovalDate          DateTime?              @map("client_approval_date") @db.Date
  clientApprovalEvidence      String?                @map("client_approval_evidence") @db.VarChar(255)
  approvedByAttorneyId        String?                @map("approved_by_attorney_id") @db.VarChar(36)
  approvedAt                  DateTime?              @map("approved_at") @db.DateTime(3)
  createdByUserId             String                 @map("created_by_user_id") @db.VarChar(36)
  notes                       String?                @db.Text
  createdAt                   DateTime               @default(now()) @map("created_at") @db.DateTime(3)

  settlementDisbursement      PISettlementDisbursement @relation(fields: [settlementDisbursementId], references: [id], onDelete: Restrict)
  signedClosingStatementDoc   Document?              @relation("ClosingStatementDoc", fields: [signedClosingStatementDocId], references: [id], onDelete: Restrict)
  approvedByAttorney          User?                  @relation("SettlementAttorneyApprover", fields: [approvedByAttorneyId], references: [id], onDelete: Restrict)
  createdByUser               User                   @relation("SettlementVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  executionRecord             PISettlementExecution?

  @@unique([settlementDisbursementId, versionNumber], name: "uq_settlement_version")
  @@map("pi_settlement_disbursement_versions")
}

model PISettlementExecution {
  id                    String                          @id @default(uuid()) @db.VarChar(36)
  settlementVersionId   String                          @unique @map("settlement_version_id") @db.VarChar(36)
  trustSubLedgerId      String                          @map("trust_sub_ledger_id") @db.VarChar(36)
  idempotencyKey        String                          @unique @map("idempotency_key") @db.VarChar(100)
  executedByUserId      String                          @map("executed_by_user_id") @db.VarChar(36)
  executedAt            DateTime                        @default(now()) @map("executed_at") @db.DateTime(3)

  settlementVersion     PISettlementDisbursementVersion @relation(fields: [settlementVersionId], references: [id], onDelete: Restrict)
  trustSubLedger        TrustSubLedger                  @relation(fields: [trustSubLedgerId], references: [id], onDelete: Restrict)
  executedByUser        User                            @relation("SettlementDisbursementExecutor", fields: [executedByUserId], references: [id], onDelete: Restrict)
  lines                 PISettlementExecutionLine[]

  @@unique([id, trustSubLedgerId], name: "uq_execution_subledger")
  @@map("pi_settlement_executions")
}

model PISettlementExecutionLine {
  id                    String                @id @default(uuid()) @db.VarChar(36)
  settlementExecutionId String                @map("settlement_execution_id") @db.VarChar(36)
  trustSubLedgerId      String                @map("trust_sub_ledger_id") @db.VarChar(36)
  trustTransactionId    String                @unique @map("trust_transaction_id") @db.VarChar(36)
  disbursementRole      String                @map("disbursement_role") @db.VarChar(50) // GROSS_DEPOSIT, ATTORNEY_FEE, LITIGATION_COSTS, LIEN_PAYOFF, CLIENT_NET
  lineIdentifier        String                @map("line_identifier") @db.VarChar(100) // GROSS_DEPOSIT, ATTORNEY_FEE, LITIGATION_COSTS, CLIENT_NET, or LIEN:<lienId>
  lienId                String?               @map("lien_id") @db.VarChar(36)
  amount                Decimal               @db.Decimal(12, 2)
  payeeName             String?               @map("payee_name") @db.VarChar(200)
  createdAt             DateTime              @default(now()) @map("created_at") @db.DateTime(3)

  settlementExecution   PISettlementExecution @relation(fields: [settlementExecutionId, trustSubLedgerId], references: [id, trustSubLedgerId], onDelete: Restrict)
  trustTransaction      TrustTransaction      @relation(fields: [trustTransactionId, trustSubLedgerId], references: [id, trustSubLedgerId], onDelete: Restrict)
  lien                  PILien?               @relation(fields: [lienId], references: [id], onDelete: Restrict)

  @@unique([settlementExecutionId, lineIdentifier], name: "uq_execution_line_identifier")
  @@unique([trustTransactionId, trustSubLedgerId], name: "uq_execution_line_tx_subledger")
  @@index([trustSubLedgerId], name: "idx_execution_lines_subledger")
  @@index([lienId], name: "idx_execution_lines_lien")
  @@map("pi_settlement_execution_lines")
}

