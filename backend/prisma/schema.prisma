// ==============================================================================
// HEUGLY & BLUDWORTH Legal Practice Management SaaS - Master Prisma Schema
// Target Database: MySQL 8.4 LTS (InnoDB Storage Engine)
// Provider: mysql
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. IDENTITY, USERS & RBAC MATRIX
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userCode        String    @unique @map("user_code") @db.VarChar(20)
  name            String    @db.VarChar(255)
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  role            String    @db.VarChar(50)
  title           String?   @db.VarChar(100)
  initials        String    @db.VarChar(10)
  department      String?   @db.VarChar(100)
  billingRate     Decimal   @default(0.00) @map("billing_rate") @db.Decimal(10, 2)
  status          String    @default("Active") @db.VarChar(20)
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecret       String?   @map("mfa_secret") @db.VarChar(255)
  lastLoginAt     DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  roleRel                 Role?                    @relation(fields: [role], references: [id])
  clientsAssigned         Client[]                 @relation("AssignedAttorney")
  mattersAssigned         Matter[]                 @relation("ResponsibleAttorney")
  matterStaffAssignments  MatterStaffAssignment[]
  intakesReviewed         Intake[]                 @relation("IntakeReviewer")
  conflictSearchLogs      ConflictSearchLog[]
  stageHistories          MatterStageHistory[]
  tasksAssigned           Task[]                   @relation("TaskAssignee")
  tasksCreated            Task[]                   @relation("TaskCreator")
  calendarEvents          CalendarEvent[]
  timeEntries             TimeEntry[]
  timeEntriesApproved     TimeEntry[]              @relation("TimeApprover")
  expensesIncurred        Expense[]
  paymentRecords          PaymentRecord[]
  trustTransactionsAuth   TrustTransaction[]
  generalLedgerJournals   GeneralLedgerJournal[]
  reconciliationsAudited  ThreeWayReconciliation[]
  documentVersionsUpload  DocumentVersion[]
  auditLogs               AuditLog[]
  templatesCreated        DocumentTemplate[]       @relation("TemplateCreator")
  templateVersionsUpload  TemplateVersion[]        @relation("TemplateVersionCreator")
  draftsGenerated          DocumentDraft[]                  @relation("DraftGenerator")
  draftsReviewed           DocumentDraft[]                  @relation("DraftReviewer")
  piVendorStaffAssignments PIVendorAssignment[]              @relation("VendorStaffAssignee")
  piDemandsApproved        PIDemandPackage[]                 @relation("DemandApprover")
  piLienNegotiations       PILienNegotiation[]               @relation("LienNegotiator")
  piSettlementVersionsMade PISettlementDisbursementVersion[] @relation("SettlementVersionCreator")
  piSettlementsApproved    PISettlementDisbursementVersion[] @relation("SettlementAttorneyApprover")
  piSettlementsExecuted    PISettlementExecution[]           @relation("SettlementDisbursementExecutor")
  piMedicalPaymentsCreated MedicalPaymentRecord[]            @relation("MedicalPaymentCreator")

  @@map("users")
}

model Role {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id            String   @id @default(uuid()) @db.VarChar(36)
  roleId        String   @map("role_id") @db.VarChar(50)
  permissionKey String   @map("permission_key") @db.VarChar(100)
  grantedAt     DateTime @default(now()) @map("granted_at") @db.DateTime(3)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey], name: "uq_role_permission")
  @@map("role_permissions")
}

// -----------------------------------------------------------------------------
// 2. CLIENTS, INTAKES & CONFLICT CLEARANCE (Utah RPC 1.7)
// -----------------------------------------------------------------------------

model Client {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  clientNumber        String   @unique @map("client_number") @db.VarChar(50)
  name                String   @db.VarChar(255)
  clientType          String   @map("client_type") @db.VarChar(50)
  primaryContact      String?  @map("primary_contact") @db.VarChar(255)
  email               String   @db.VarChar(255)
  phone               String   @db.VarChar(50)
  address             String?  @db.Text
  assignedAttorneyId  String?  @map("assigned_attorney_id") @db.VarChar(36)
  status              String   @default("Active") @db.VarChar(20)
  notes               String?  @db.Text
  portalAccessEnabled Boolean  @default(false) @map("portal_access_enabled")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  assignedAttorney User?            @relation("AssignedAttorney", fields: [assignedAttorneyId], references: [id], onDelete: SetNull)
  matters          Matter[]
  invoices         Invoice[]
  trustSubLedgers  TrustSubLedger[]
  documents        Document[]
  convertedIntakes Intake[]         @relation("ConvertedClient")
  paymentRecords   PaymentRecord[]
  documentDrafts   DocumentDraft[]

  @@index([name, email, clientNumber], name: "idx_clients_search")
  @@map("clients")
}

model Intake {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  intakeNumber        String    @unique @map("intake_number") @db.VarChar(50)
  prospectiveClient   String    @map("prospective_client") @db.VarChar(255)
  contactPerson       String?   @map("contact_person") @db.VarChar(255)
  email               String    @db.VarChar(255)
  phone               String    @db.VarChar(50)
  practiceAreaId      String?   @map("practice_area_id") @db.VarChar(50)
  adverseParties      String    @map("adverse_parties") @db.Text
  matterSummary       String    @map("matter_summary") @db.Text
  disputeAmount       Decimal?  @default(0.00) @map("dispute_amount") @db.Decimal(12, 2)
  jurisdictionVenue   String?   @map("jurisdiction_venue") @db.VarChar(255)
  conflictStatus      String    @default("Not Started") @map("conflict_status") @db.VarChar(50)
  reviewedByUserId    String?   @map("reviewed_by_user_id") @db.VarChar(36)
  reviewedAt          DateTime? @map("reviewed_at") @db.DateTime(3)
  conflictNotes       String?   @map("conflict_notes") @db.Text
  convertedToClient   Boolean   @default(false) @map("converted_to_client")
  convertedClientId   String?   @map("converted_client_id") @db.VarChar(36)
  convertedMatterId   String?   @map("converted_matter_id") @db.VarChar(36)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  practiceArea       PracticeArea?       @relation(fields: [practiceAreaId], references: [id], onDelete: SetNull)
  reviewedByUser     User?               @relation("IntakeReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  convertedClient    Client?             @relation("ConvertedClient", fields: [convertedClientId], references: [id], onDelete: SetNull)
  convertedMatter    Matter?             @relation("ConvertedMatter", fields: [convertedMatterId], references: [id], onDelete: SetNull)
  conflictSearchLogs ConflictSearchLog[]

  @@map("intakes")
}

model ConflictSearchLog {
  id                String   @id @default(uuid()) @db.VarChar(36)
  intakeId          String   @map("intake_id") @db.VarChar(36)
  queriedName       String   @map("queried_name") @db.VarChar(255)
  matchedEntityType String   @map("matched_entity_type") @db.VarChar(50)
  matchedRecordId   String   @map("matched_record_id") @db.VarChar(100)
  searchedByUserId  String   @map("searched_by_user_id") @db.VarChar(36)
  searchedAt        DateTime @default(now()) @map("searched_at") @db.DateTime(3)

  intake         Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  searchedByUser User   @relation(fields: [searchedByUserId], references: [id], onDelete: Restrict)

  @@map("conflict_search_logs")
}

// -----------------------------------------------------------------------------
// 3. MATTERS & WORKFLOWS (Filevine Model)
// -----------------------------------------------------------------------------

model PracticeArea {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(10)
  brandColor  String   @map("brand_color") @db.VarChar(20)
  isActive    Boolean  @default(true) @map("is_active")

  matters        Matter[]
  intakes        Intake[]
  workflowStages WorkflowStage[]
  documentTemplates DocumentTemplate[]

  @@map("practice_areas")
}

model Matter {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  matterNumber          String    @unique @map("matter_number") @db.VarChar(50)
  clientId              String    @map("client_id") @db.VarChar(36)
  title                 String    @db.VarChar(255)
  practiceAreaId        String    @map("practice_area_id") @db.VarChar(50)
  currentStageId        String?   @map("current_stage_id") @db.VarChar(50)
  status                String    @default("Active") @db.VarChar(50)
  responsibleAttorneyId String    @map("responsible_attorney_id") @db.VarChar(36)
  billingType           String    @map("billing_type") @db.VarChar(50)
  hourlyRate            Decimal?  @map("hourly_rate") @db.Decimal(10, 2)
  flatFeeAmount         Decimal?  @map("flat_fee_amount") @db.Decimal(12, 2)
  contingencyPercentage Decimal?  @map("contingency_percentage") @db.Decimal(5, 2)
  budget                Decimal   @default(0.00) @db.Decimal(12, 2)
  openDate              DateTime  @map("open_date") @db.Date
  closeDate             DateTime? @map("close_date") @db.Date
  statuteOfLimitations DateTime? @map("statute_of_limitations") @db.Date
  nextCourtDate         DateTime? @map("next_court_date") @db.DateTime(3)
  courtName             String?   @map("court_name") @db.VarChar(255)
  judge                 String?   @db.VarChar(150)
  caseDocketNumber      String?   @map("case_docket_number") @db.VarChar(100)
  description           String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  client                Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  practiceArea          PracticeArea            @relation(fields: [practiceAreaId], references: [id], onDelete: Restrict)
  responsibleAttorney   User                    @relation("ResponsibleAttorney", fields: [responsibleAttorneyId], references: [id], onDelete: Restrict)
  currentStage          WorkflowStage?          @relation(fields: [currentStageId], references: [id], onDelete: SetNull)
  staffAssignments      MatterStaffAssignment[]
  stageHistories        MatterStageHistory[]
  tasks                 Task[]
  calendarEvents        CalendarEvent[]
  timeEntries           TimeEntry[]
  suggestedCaptures     SuggestedBillingCapture[]
  expenses              Expense[]
  invoices              Invoice[]
  trustSubLedger        TrustSubLedger?
  generalLedgerEntries  GeneralLedgerEntry[]
  documents             Document[]
  originatingIntakes    Intake[]                @relation("ConvertedMatter")
  documentDrafts        DocumentDraft[]
  incidents             Incident[]
  insurancePolicies       InsurancePolicy[]
  medicalProviders        MedicalProvider[]
  medicalRecordRequests   MedicalRecordRequest[]
  medicalBillingSummaries MedicalBillingSummary[]
  vendorAssignments       PIVendorAssignment[]
  demandPackages          PIDemandPackage[]
  liens                   PILien[]
  settlementDisbursements PISettlementDisbursement[]
  damagesRecords          PIDamagesRecord[]
  diagnosticStudies       PIDiagnosticStudy[]
  wageLossRecords         PIWageLossRecord[]

  @@index([clientId], name: "idx_matters_client")
  @@index([responsibleAttorneyId], name: "idx_matters_attorney")
  @@map("matters")
}

model MatterStaffAssignment {
  id             String   @id @default(uuid()) @db.VarChar(36)
  matterId       String   @map("matter_id") @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  assignmentRole String   @map("assignment_role") @db.VarChar(50)
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId], name: "uq_matter_staff")
  @@map("matter_staff_assignments")
}

model WorkflowStage {
  id             String  @id @db.VarChar(50)
  practiceAreaId String  @map("practice_area_id") @db.VarChar(50)
  stageName      String  @map("stage_name") @db.VarChar(150)
  stageCode      String  @map("stage_code") @db.VarChar(20)
  stageOrder     Int     @map("stage_order")
  requiredFields Json    @map("required_fields")
  autoTasks      Json    @map("auto_tasks")
  isActive       Boolean @default(true) @map("is_active")

  practiceArea   PracticeArea         @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)
  matters        Matter[]
  stageHistories MatterStageHistory[]

  @@map("workflow_stages")
}

model MatterStageHistory {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  matterId             String   @map("matter_id") @db.VarChar(36)
  fromStageId          String?  @map("from_stage_id") @db.VarChar(50)
  toStageId            String   @map("to_stage_id") @db.VarChar(50)
  transitionedByUserId String   @map("transitioned_by_user_id") @db.VarChar(36)
  verifiedGatekeepers  Json     @map("verified_gatekeepers")
  transitionedAt       DateTime @default(now()) @map("transitioned_at") @db.DateTime(3)

  matter               Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  toStage              WorkflowStage @relation(fields: [toStageId], references: [id], onDelete: Restrict)
  transitionedByUser   User          @relation(fields: [transitionedByUserId], references: [id], onDelete: Restrict)

  @@map("matter_stage_histories")
}

// -----------------------------------------------------------------------------
// 4. TASKS, CALENDAR & COURT DEADLINES (Utah URCP Rule 6)
// -----------------------------------------------------------------------------

model Task {
  id                String    @id @default(uuid()) @db.VarChar(36)
  taskCode          String    @unique @map("task_code") @db.VarChar(50)
  matterId          String    @map("matter_id") @db.VarChar(36)
  title             String    @db.VarChar(255)
  description       String?   @db.Text
  assignedToUserId  String    @map("assigned_to_user_id") @db.VarChar(36)
  createdByUserId   String    @map("created_by_user_id") @db.VarChar(36)
  dueDate           DateTime  @map("due_date") @db.Date
  priority          String    @default("Medium") @db.VarChar(20)
  status            String    @default("Not Started") @db.VarChar(30)
  completedAt       DateTime? @map("completed_at") @db.DateTime(3)
  reminderSetting   String?   @default("1 day prior") @map("reminder_setting") @db.VarChar(50)
  urcpRuleReference String?   @map("urcp_rule_reference") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  matter   Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  assignee User   @relation("TaskAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  creator  User   @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([assignedToUserId, dueDate, status], name: "idx_tasks_assigned_due")
  @@map("tasks")
}

model CalendarEvent {
  id                String   @id @default(uuid()) @db.VarChar(36)
  matterId          String?  @map("matter_id") @db.VarChar(36)
  title             String   @db.VarChar(255)
  eventType         String   @map("event_type") @db.VarChar(50)
  startTime         DateTime @map("start_time") @db.DateTime(3)
  endTime           DateTime @map("end_time") @db.DateTime(3)
  location          String?  @db.VarChar(255)
  judge             String?  @db.VarChar(150)
  isCourtAppearance Boolean  @default(false) @map("is_court_appearance")
  createdByUserId   String   @map("created_by_user_id") @db.VarChar(36)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  matter  Matter? @relation(fields: [matterId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("calendar_events")
}

// -----------------------------------------------------------------------------
// 5. TIME TRACKING, SUGGESTED BILLING & EXPENSES
// -----------------------------------------------------------------------------

model TimeEntry {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  entryCode          String    @unique @map("entry_code") @db.VarChar(50)
  matterId           String    @map("matter_id") @db.VarChar(36)
  userId             String    @map("user_id") @db.VarChar(36)
  date               DateTime  @db.Date
  hours              Decimal   @db.Decimal(5, 2)
  rate               Decimal   @db.Decimal(10, 2)
  amount             Decimal   @db.Decimal(12, 2)
  activityType       String    @map("activity_type") @db.VarChar(100)
  activityCode       String?   @map("activity_code") @db.VarChar(50)
  description        String    @db.Text
  isBillable         Boolean   @default(true) @map("is_billable")
  status             String    @default("Submitted") @db.VarChar(30)
  approvedByUserId   String?   @map("approved_by_user_id") @db.VarChar(36)
  approvedAt         DateTime? @map("approved_at") @db.DateTime(3)
  rejectionComment   String?   @map("rejection_comment") @db.Text
  exportedToCosmolex Boolean   @default(false) @map("exported_to_cosmolex")
  exportBatchId      String?   @map("export_batch_id") @db.VarChar(50)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  matter             Matter                    @relation(fields: [matterId], references: [id], onDelete: Restrict)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  approver           User?                     @relation("TimeApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  suggestedCaptures  SuggestedBillingCapture[]
  invoiceLineItems   InvoiceLineItem[]

  @@index([matterId, status], name: "idx_time_matter_status")
  @@index([userId, date], name: "idx_time_user_date")
  @@map("time_entries")
}

model SuggestedBillingCapture {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  sourceType            String   @map("source_type") @db.VarChar(50)
  sourceIdentifier      String   @unique @map("source_identifier") @db.VarChar(255)
  matterId              String?  @map("matter_id") @db.VarChar(36)
  date                  DateTime @db.Date
  actualDurationSeconds Int      @map("actual_duration_seconds")
  suggestedHours        Decimal  @map("suggested_hours") @db.Decimal(4, 2)
  matchConfidence       Int      @map("match_confidence")
  activityDescription   String   @map("activity_description") @db.Text
  detectedRate          Decimal? @map("detected_rate") @db.Decimal(10, 2)
  isConverted           Boolean  @default(false) @map("is_converted")
  convertedTimeEntryId  String?  @map("converted_time_entry_id") @db.VarChar(36)
  isDismissed           Boolean  @default(false) @map("is_dismissed")
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)

  matter             Matter?    @relation(fields: [matterId], references: [id], onDelete: SetNull)
  convertedTimeEntry TimeEntry? @relation(fields: [convertedTimeEntryId], references: [id], onDelete: SetNull)

  @@map("suggested_billing_captures")
}

model Expense {
  id                String   @id @default(uuid()) @db.VarChar(36)
  expenseCode       String   @unique @map("expense_code") @db.VarChar(50)
  matterId          String   @map("matter_id") @db.VarChar(36)
  incurredByUserId  String   @map("incurred_by_user_id") @db.VarChar(36)
  date              DateTime @db.Date
  category          String   @db.VarChar(100)
  amount            Decimal  @db.Decimal(12, 2)
  vendorName        String?  @map("vendor_name") @db.VarChar(255)
  receiptDocumentId String?  @map("receipt_document_id") @db.VarChar(36)
  isBillable        Boolean  @default(true) @map("is_billable")
  status            String   @default("Unbilled") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  matter              Matter               @relation(fields: [matterId], references: [id], onDelete: Restrict)
  incurredByUser      User                 @relation(fields: [incurredByUserId], references: [id], onDelete: Restrict)
  invoiceLineItems    InvoiceLineItem[]
  piVendorAssignments PIVendorAssignment[]

  @@map("expenses")
}

// -----------------------------------------------------------------------------
// 6. INVOICES, LINE ITEMS & CASH RECEIPTS
// -----------------------------------------------------------------------------

model Invoice {
  id            String    @id @default(uuid()) @db.VarChar(36)
  invoiceNumber String    @unique @map("invoice_number") @db.VarChar(50)
  clientId      String    @map("client_id") @db.VarChar(36)
  matterId      String    @map("matter_id") @db.VarChar(36)
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date
  totalAmount   Decimal   @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal   @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue    Decimal   @map("balance_due") @db.Decimal(12, 2)
  status        String    @default("Draft") @db.VarChar(30)
  sentAt        DateTime? @map("sent_at") @db.DateTime(3)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matter         Matter          @relation(fields: [matterId], references: [id], onDelete: Restrict)
  lineItems      InvoiceLineItem[]
  paymentRecords PaymentRecord[]

  @@map("invoices")
}

model InvoiceLineItem {
  id          String   @id @default(uuid()) @db.VarChar(36)
  invoiceId   String   @map("invoice_id") @db.VarChar(36)
  itemType    String   @map("item_type") @db.VarChar(20)
  timeEntryId String?  @map("time_entry_id") @db.VarChar(36)
  expenseId   String?  @map("expense_id") @db.VarChar(36)
  description String   @db.Text
  quantity    Decimal  @db.Decimal(5, 2)
  unitRate    Decimal  @map("unit_rate") @db.Decimal(10, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)

  invoice   Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry TimeEntry? @relation(fields: [timeEntryId], references: [id], onDelete: SetNull)
  expense   Expense?   @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@map("invoice_line_items")
}

model PaymentRecord {
  id                   String   @id @default(uuid()) @db.VarChar(36)
  paymentReference     String   @unique @map("payment_reference") @db.VarChar(50)
  invoiceId            String   @map("invoice_id") @db.VarChar(36)
  clientId             String   @map("client_id") @db.VarChar(36)
  amount               Decimal  @db.Decimal(12, 2)
  paymentMethod        String   @map("payment_method") @db.VarChar(50)
  destinationAccount   String   @map("destination_account") @db.VarChar(50)
  transactionReference String?  @map("transaction_reference") @db.VarChar(100)
  receivedDate         DateTime @map("received_date") @db.Date
  recordedByUserId     String   @map("recorded_by_user_id") @db.VarChar(36)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)

  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  client         Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  recordedByUser User    @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@map("payment_records")
}

// -----------------------------------------------------------------------------
// 7. IOLTA TRUST ACCOUNTING & 3-WAY RECONCILIATION (Utah RPC 1.15)
// -----------------------------------------------------------------------------

model TrustSubLedger {
  id            String   @id @default(uuid()) @db.VarChar(36)
  ledgerCode    String   @unique @map("ledger_code") @db.VarChar(50)
  clientId      String   @map("client_id") @db.VarChar(36)
  matterId      String   @unique @map("matter_id") @db.VarChar(36)
