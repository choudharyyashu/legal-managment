  piClosingStatements      PISettlementDisbursementVersion[] @relation("ClosingStatementDoc")
  piDiagnosticReports      PIDiagnosticStudy[]               @relation("DiagnosticReportDoc")
  piWageLossVerifications  PIWageLossRecord[]                @relation("WageLossDoc")

  @@map("documents")
}

model DocumentVersion {
  id               String   @id @default(uuid()) @db.VarChar(36)
  documentId       String   @map("document_id") @db.VarChar(36)
  versionLabel     String   @map("version_label") @db.VarChar(20)
